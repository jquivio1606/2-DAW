{% extends 'base.html.twig' %}

{% block title %}Tienda{% endblock %}

{% block body %}
    <br><br>
    <div class="cont-main">
        <h1 class="text-6xl text-center"><i>Categorías</i></h1>
        
        <div class="cont-categorias">
            {% if categorias is empty %}
                <p class="vacio text-center">No hay categorías disponibles.</p>
            {% else %}
                    {% for categoria in categorias %}
                        <a href="{{ path('productos_categoria', {'id': categoria.id}) }}" class="enlace-cat">
                            <h4>{{ categoria.nombre }}</h4>
                        </a>
                    {% endfor %}
        </div>
        {% endif %}
    </div>
{% endblock %}
