{% extends 'base.html.twig' %}

{% block title %}Productos - {{ categoria.nombre }}{% endblock %}

{% block body %}
    <div class="bg-gray-900 py-10">
        <div class="container mx-auto px-4">
            <h1 class="text-6xl text-white text-center"><i>Productos</i></h1>
        </div>
    </div>
    <div class="cont-prod mx-auto px-4 py-4">
        <h3 class="text-3xl text-gray-900 text-center pb-4">{{ categoria.nombre }}</h3>
        <div class="flex flex-col gap-2 justify-center items-center">
            {% if productos is empty %}
                <p class="vacio card-prod p-4 text-center">No hay productos disponibles en esta categoría.</p>
            {% else %}
                {% for producto in productos %}
                    <div class="card-prod bg-gray-200 p-4 w-80">
                        <h4 class="text-xl">{{ producto.nombre }}</h4>
                        <p>{{ producto.descripcion }}</p>
                        <p class="text-gray-700">Precio: {{ producto.precio }}</p>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
{% endblock %}