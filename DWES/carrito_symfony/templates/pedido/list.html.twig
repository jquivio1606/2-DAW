{% extends 'base.html.twig' %}

{% block title %}Lista de Pedidos{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .pedidos-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }
        .pedido-item {
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 4px;
            padding: 10px;
            margin-bottom: 10px;
        }
        .pedido-link {
            color: #007bff;
            text-decoration: none;
        }
        .pedido-link:hover {
            text-decoration: underline;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="pedidos-container">
        <h1 style="color: #333; margin-bottom: 20px;">Lista de Pedidos</h1>
        {% for pedido in pedidos %}
            <div class="pedido-item">
                <a href="{{ path('pedido_detalle', {'id': pedido.id}) }}" class="pedido-link">
                    Pedido #{{ pedido.id }} - Fecha: {{ pedido.fecha|date('d/m/Y H:i') }}
                </a>
            </div>
        {% endfor %}
    </div>
{% endblock %}
