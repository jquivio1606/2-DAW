{% extends 'base.html.twig' %}

{% block title %}Carrito de Compras{% endblock %}

{% block body %}
    <div class="container mx-auto mt-8 p-4">
        <h1 class="text-2xl font-bold mb-4">Carrito de Compras</h1>
        
        {% if carrito is empty %}
            <p>Tu carrito está vacío.</p>
        {% else %}
            <table class="w-full border-collapse border border-gray-300">
                <thead>
                    <tr class="bg-gray-100">
                        <th class="border border-gray-300 px-4 py-2">Producto</th>
                        <th class="border border-gray-300 px-4 py-2">Cantidad</th>
                        <th class="border border-gray-300 px-4 py-2">Precio</th>
                        <th class="border border-gray-300 px-4 py-2">Subtotal</th>
                        <th class="border border-gray-300 px-4 py-2">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for id, item in carrito %}
                        <tr>
                            <td class="border border-gray-300 px-4 py-2">{{ item.nombre }}</td>
                            <td class="border border-gray-300 px-4 py-2">
                                <form action="{{ path('actualizar_carrito', {'id': id}) }}" method="post" class="flex items-center">
                                    <input type="number" name="cantidad" value="{{ item.cantidad }}" min="1" class="w-16 px-2 py-1 border rounded">
                                    <button type="submit" style="background-color: #3b82f6; color: white; padding: 4px 8px; border-radius: 4px; margin-left: 8px;">Actualizar</button>
                                </form>
                            </td>
                            <td class="border border-gray-300 px-4 py-2">{{ item.precio }} €</td>
                            <td class="border border-gray-300 px-4 py-2">{{ (item.precio * item.cantidad) }} €</td>
                            <td class="border border-gray-300 px-4 py-2">
                                <a href="{{ path('remove_from_cart', {'id': id}) }}" class="text-red-500 hover:text-red-700">Eliminar</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr class="font-bold">
                        <td colspan="3" class="border border-gray-300 px-4 py-2 text-right">Total:</td>
                        <td class="border border-gray-300 px-4 py-2">{{ total }} €</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
            
            <div class="mt-4">
                <form action="{{ path('realizar_pedido') }}" method="post">
                    <button type="submit" style="background-color: #10B981; color: white; padding: 8px 16px; border-radius: 4px;">Realizar Pedido</button>
                </form>
            </div>
        {% endif %}
    </div>
{% endblock %}
