{% extends 'base.html.twig' %}

{% block title %}Tienda - Login{% endblock %}
{% block body %}
    <div class="max-w-md mx-auto pt-10">
        <h2 class="text-3xl text-gray-900 text-center mb-6">Iniciar Sesión</h2>

        <form method="post" action="{{ path('app_login') }}" class="shadow-md bg-white p-6 rounded-lg">
            {% if error %}
                <div class="text-red-600 text-center mb-4">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% if app.user %}
                <div class="text-gray-600 text-center mb-4">
                    Ya has iniciado sesión como: {{ app.user.email }}.
                </div>
            {% else %}
                <div>
                    <label for="email" class="block text-gray-600 font-bold mb-2">Email</label>
                    <input type="text" name="_email" id="email" class="w-full px-3 py-2 border-2 rounded" required autofocus>
                </div>

                <div class="mt-4">
                    <label for="password" class="block text-gray-600 font-bold mb-2">Contraseña</label>
                    <input type="password" name="_password" id="password" class="w-full px-3 py-2 border-2 rounded" required>
                </div>

                <div class="mt-6 flex justify-center">
                    <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700">Entrar</button>
                </div>
            {% endif %}
        </form>
    </div>
{% endblock %}